{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.py" },
    { "source": "/style.css", "destination": "/dashboard/static/style.css" },
    { "source": "/app.js", "destination": "/dashboard/static/app.js" },
    { "source": "/", "destination": "/dashboard/static/index.html" },
    { "source": "/(.*)", "destination": "/server.py" }
  ]
}
